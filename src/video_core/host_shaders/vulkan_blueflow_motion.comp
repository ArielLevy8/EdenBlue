#version 450

// Block-matching motion estimation. Each output texel covers one 8x8 pixel block and stores the
// UV displacement from the previous frame to the current one, plus a match confidence in .b.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler linear_sampler;
layout(binding = 1) uniform texture2D prev_frame;
layout(binding = 2) uniform texture2D cur_frame;
layout(binding = 3) uniform texture2D prior_motion;
layout(binding = 4, rgba16f) uniform writeonly image2D out_motion;

const int GRID = 4;
const float SAMPLE_COUNT = float(GRID * GRID);
const float ZERO_BIAS = 0.9;
const float MATCH_RANGE = 0.25;

vec2 pixel_size;

float Luma(vec3 color) {
    return dot(color, vec3(0.299, 0.587, 0.114));
}

float CurrentLuma(vec2 uv) {
    return Luma(textureLod(sampler2D(cur_frame, linear_sampler), uv, 0.0).rgb);
}

float PreviousLuma(vec2 uv) {
    return Luma(textureLod(sampler2D(prev_frame, linear_sampler), uv, 0.0).rgb);
}

float BlockCost(vec2 uv, vec2 motion) {
    float cost = 0.0;
    for (int y = 0; y < GRID; ++y) {
        for (int x = 0; x < GRID; ++x) {
            const vec2 offset = (vec2(x, y) - 1.5) * 2.0 * pixel_size;
            const vec2 position = uv + offset;
            cost += abs(CurrentLuma(position) - PreviousLuma(position - motion));
        }
    }
    return cost;
}

void main() {
    const ivec2 size = imageSize(out_motion);
    const ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(id, size))) {
        return;
    }

    pixel_size = 1.0 / vec2(textureSize(sampler2D(cur_frame, linear_sampler), 0));
    const vec2 uv = (vec2(id) + 0.5) / vec2(size);
    const vec2 block_uv = 1.0 / vec2(size);

    vec2 best = vec2(0.0);
    // Prefer no motion on ties so static scenes and HUD elements stay stable.
    float best_cost = BlockCost(uv, best) * ZERO_BIAS;

    const vec2 prior_offsets[5] =
        vec2[5](vec2(0.0), vec2(1.0, 0.0), vec2(-1.0, 0.0), vec2(0.0, 1.0), vec2(0.0, -1.0));
    for (int i = 0; i < 5; ++i) {
        const vec2 candidate =
            textureLod(sampler2D(prior_motion, linear_sampler), uv + prior_offsets[i] * block_uv,
                       0.0)
                .xy;
        const float cost = BlockCost(uv, candidate);
        if (cost < best_cost) {
            best_cost = cost;
            best = candidate;
        }
    }

    const vec2 directions[8] =
        vec2[8](vec2(1.0, 0.0), vec2(-1.0, 0.0), vec2(0.0, 1.0), vec2(0.0, -1.0),
                vec2(1.0, 1.0), vec2(-1.0, 1.0), vec2(1.0, -1.0), vec2(-1.0, -1.0));
    for (float step_pixels = 16.0; step_pixels >= 1.0; step_pixels *= 0.5) {
        const vec2 center = best;
        for (int i = 0; i < 8; ++i) {
            const vec2 candidate = center + directions[i] * step_pixels * pixel_size;
            const float cost = BlockCost(uv, candidate);
            if (cost < best_cost) {
                best_cost = cost;
                best = candidate;
            }
        }
    }

    const float confidence = 1.0 - clamp(best_cost / (SAMPLE_COUNT * MATCH_RANGE), 0.0, 1.0);
    imageStore(out_motion, id, vec4(best, confidence, 1.0));
}
